@PACKAGE_INIT@

set(LinuxDesktop2026_PACKAGE_VERSION_COMPATIBILITY "@LD2026_PACKAGE_VERSION_COMPATIBILITY@")
set(LinuxDesktop2026_PRE_1_0_EXACT_VERSION_REQUIRED @LD2026_PRE_1_0_EXACT_VERSION_REQUIRED@)

set(LinuxDesktop2026_HAS_LIBUV @LD2026_CONFIG_HAS_LIBUV@)
if(LinuxDesktop2026_HAS_LIBUV)
    include(CMakeFindDependencyMacro)
    find_dependency(PkgConfig)
    pkg_check_modules(LIBUV REQUIRED IMPORTED_TARGET libuv)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LinuxDesktop2026Targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LinuxDesktop2026PathDefaults.cmake")
